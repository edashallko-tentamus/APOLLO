# Copy this file to .env (never committed) and fill in the password.
# Every command reads it: npm start, npm test, npm run reset and npm run start:java.
# The databases must already exist (backend/db/create_database.sql makes them); the app makes the tables.

# Local PostgreSQL 16 (README, "Local PostgreSQL")
POSTGRES_PASSWORD=<choose one>
DATABASE_URL=postgres://lims:<same password>@localhost:5432/lims3?sslmode=disable
# npm test empties this one before every run: never the same as DATABASE_URL
LIMS_TEST_DATABASE_URL=postgres://lims:<same password>@localhost:5432/lims3_test?sslmode=disable

# The Java backend: the port it listens on, and where the front end sends the routes it has taken over.
# Leave LIMS_JAVA_URL out to send everything to the Node backend.
LIMS_JAVA_PORT=3002
LIMS_JAVA_URL=http://127.0.0.1:3002

# Optional settings (the defaults are shown; uncomment to change).
# Where the migrations and demo data are, relative to backend-java (the Java backend applies them at start)
#LIMS_DB_ROOT=../backend/db
# GxP server only: the owner account that runs the migrations (DATABASE_URL is then the restricted app account)
#LIMS_MIGRATE_URL=postgres://lims_owner:<password>@localhost:5432/lims3?sslmode=disable
# Sign-in: minutes without activity before a session ends; 1 when served over HTTPS (Secure cookie, HSTS)
#LIMS_IDLE_MINUTES=30
#LIMS_HTTPS=0
# Per computer: wrong passwords allowed in 15 minutes; requests a minute to the public pages; 1 behind a proxy (X-Forwarded-For)
#LIMS_FAIL_LIMIT=20
#LIMS_PUBLIC_LIMIT=120
#LIMS_TRUST_PROXY=0
# A Chromium to use for PDFs and screenshots instead of the one Playwright downloads on first use
#PLAYWRIGHT_PATH=<path to chrome.exe>
# The address people open, printed in PDFs and emails (else http://localhost:PORT); PORT is the front end's port
#LIMS_PUBLIC_URL=https://lims.example.com
#PORT=3000
# The iMonnit API key, for a real sensor connection (the pretend Sandbox service needs none)
#LIMS_IMONNIT_KEY=<key from iMonnit>
