# Copy this file to .env (never committed) and fill in the password.
# npm run start:pg and npm run test:pg read it, and so does npm run start:java (the Java backend).

# Local PostgreSQL 16 (README, "Local PostgreSQL")
POSTGRES_PASSWORD=<choose one>
DATABASE_URL=postgres://lims:<same password>@localhost:5432/lims3?sslmode=disable

# The Java backend: the port it listens on, and where the front end sends the routes it has taken over.
# Leave LIMS_JAVA_URL out to send everything to the Node backend.
LIMS_JAVA_PORT=3002
LIMS_JAVA_URL=http://127.0.0.1:3002
