{
  "name": "lims3-sandbox",
  "version": "0.37.1",
  "private": true,
  "description": "LIMS3 Sandbox: slices 1-3 (clients, catalogue pricing, quotes, lab orders, samples, intake, due dates, inventory, login and signatures, permissions and lab groups, equipment, purchasing, Workflow Designer WD-1, chemistry execution WD-2, QC Review WD-3, micro bench WD-4, and on to invoicing I-1 and dashboards D-1)",
  "main": "frontend/server.js",
  "scripts": {
    "start": "node frontend/server.js",
    "start:backend": "mvn -q -f backend/pom.xml spring-boot:run",
    "start:frontend": "node frontend/server.js",
    "build:app": "npm --prefix frontend/app ci && npm --prefix frontend/app run build",
    "dev:app": "npm --prefix frontend/app run dev",
    "test": "mvn -q -f backend/pom.xml spring-boot:run -Dspring-boot.run.arguments=test",
    "test:browser": "node tests/e2e_smoke.js http://localhost:3000",
    "test:browser2": "node tests/e2e_slice2.js http://localhost:3000",
