    "test:oos": "node tests/e2e_oos.js http://localhost:3000",
    "test:quotes": "node tests/e2e_quotes.js http://localhost:3000",
    "test:labsetup": "node tests/e2e_labsetup.js http://localhost:3000",
    "test:pricing": "node tests/e2e_pricing.js http://localhost:3000",
    "test:serving": "node tests/e2e_serving.js http://localhost:3000",
